{
  "name": "prompt-forge-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:component": "cypress run --component",
    "cy:component:open": "cypress open --component",
    "cy:component:report": "cypress run --component --reporter json --reporter-options output=cypress-results.json",
    "cy:component:html": "cypress run --component --reporter mochawesome --reporter-options reportDir=cypress/reports,overwrite=false,html=true,json=true",
    "cy:run:coverage": "nyc cypress run --component",
    "coverage:report": "nyc report --reporter=html --reporter=text",
    "coverage:open": "start coverage/index.html",
    "dev": "vite",
    "build": "vite build",
    "build:prod": "vite build --mode production",
    "build:fast": "vite build",
    "typecheck": "npx --no-install tsc --noEmit",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage",
    "lint": "eslint . --config eslint.config.cjs",
    "lint:fix": "eslint . --config eslint.config.cjs --fix"
  },
  "dependencies": {
    "@paystack/inline-js": "^2.22.6",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/themes": "^3.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jspdf": "^3.0.1",
    "lucide-react": "^0.263.1",
    "prompt-forge-react": "file:",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.14.2",
    "react-toastify": "^11.0.5",
    "recharts": "^3.1.0",
    "tailwind-merge": "^1.14.0",
    "web-streams": "^0.8.0"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^3.14.5",
    "@cypress/react": "^9.0.1",
    "@cypress/react18": "^2.0.1",
    "@cypress/vite-dev-server": "^6.0.3",
    "@eslint/js": "^9.31.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/cypress": "^1.1.6",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/parser": "^6.21.0",
    "autoprefixer": "^10.4.14",
    "canvas": "^3.1.2",
    "cypress": "^14.5.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^13.20.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.0.4",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^30.0.4",
    "jest-fetch-mock": "^3.0.3",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.4.1",
    "mochawesome-report-generator": "^6.2.0",
    "nyc": "^15.1.0",
    "postcss": "^8.4.27",
    "react-test-renderer": "^18.3.1",
    "tailwindcss": "^3.3.3",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "web-streams-polyfill": "^4.1.0",
    "whatwg-fetch": "^3.6.20"
  }
}
